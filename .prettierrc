{
    "printWidth": 100,
    "tabWidth": 2,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "arrowParens": "always",
    "bracketSpacing": true,
    "jsxBracketSameLine": false,
    "bracketSameLine": false,
    "htmlWhitespaceSensitivity": "css",
    "endOfLine": "crlf"
}
